generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  EMPLOYEE
  MANAGER
  SECURITY_ADMIN
}

enum ResourceType {
  EQUIPMENT
  VEHICLE
  SECURITY_DEVICE
}

enum ResourceStatus {
  AVAILABLE
  IN_USE
  MAINTENANCE
  RETIRED
}

enum AccessResult {
  GRANTED
  DENIED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         Role     @default(EMPLOYEE)
  jobTitle     String?  @map("job_title")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  accessLogs         AccessLog[]
  permissions        AreaPermission[] @relation("PermissionHolder")
  grantedPermissions AreaPermission[] @relation("PermissionGranter")
  auditLogs          AuditLog[]

  @@map("users")
}

model Area {
  id          String   @id @default(uuid())
  name        String
  code        String   @unique
  description String?
  minimumRole Role     @default(EMPLOYEE) @map("minimum_role")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  permissions AreaPermission[]
  accessLogs  AccessLog[]
  resources   Resource[]

  @@map("areas")
}

model AreaPermission {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  areaId      String    @map("area_id")
  grantedById String    @map("granted_by_id")
  grantedAt   DateTime  @default(now()) @map("granted_at")
  expiresAt   DateTime? @map("expires_at")

  user      User @relation("PermissionHolder", fields: [userId], references: [id], onDelete: Cascade)
  area      Area @relation(fields: [areaId], references: [id], onDelete: Cascade)
  grantedBy User @relation("PermissionGranter", fields: [grantedById], references: [id])

  @@unique([userId, areaId])
  @@index([areaId])
  @@map("area_permissions")
}

model AccessLog {
  id        String       @id @default(uuid())
  userId    String       @map("user_id")
  areaId    String       @map("area_id")
  result    AccessResult
  reason    String
  ipAddress String?      @map("ip_address")
  createdAt DateTime     @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  area Area @relation(fields: [areaId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([userId])
  @@index([areaId, result])
  @@map("access_logs")
}

model Resource {
  id           String         @id @default(uuid())
  name         String
  description  String?
  type         ResourceType
  serialNumber String         @unique @map("serial_number")
  status       ResourceStatus @default(AVAILABLE)
  areaId       String?        @map("area_id")
  acquiredAt   DateTime       @map("acquired_at")
  value        Decimal?       @db.Decimal(12, 2)
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  area Area? @relation(fields: [areaId], references: [id], onDelete: SetNull)

  @@index([type])
  @@index([status])
  @@map("resources")
}

model AuditLog {
  id        String      @id @default(uuid())
  actorId   String      @map("actor_id")
  entity    String
  entityId  String      @map("entity_id")
  action    AuditAction
  changes   Json?
  createdAt DateTime    @default(now()) @map("created_at")

  actor User @relation(fields: [actorId], references: [id])

  @@index([createdAt])
  @@map("audit_logs")
}
